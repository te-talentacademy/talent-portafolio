# Convex — generadas automáticamente por `npx convex dev`
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Finnhub API key — obtener gratis en https://finnhub.io
#
# IMPORTANTE: el backend Convex NO lee este archivo.
# Ademas de copiarla aqui, hay que setearla en el deployment con:
#   npx convex env set FINNHUB_API_KEY <valor>
FINNHUB_API_KEY=
